{
  "name": "bustation",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy:web": "npm run build && npx wrangler pages deploy dist --project-name bustation --branch production",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.sim.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "cap:sync": "npm run build && cap sync android",
    "cap:open": "cap open android",
    "cap:run": "npm run build && cap run android",
    "aset": "node tools/aset/potong.mjs",
    "ikon": "node --experimental-websocket tools/ikon/buat-ikon.mjs"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "@capacitor/android": "~7.6.9",
    "@capacitor/app": "~7.1.2",
    "@capacitor/core": "~7.6.9",
    "@capacitor/preferences": "~7.0.4",
    "firebase": "^12.19.0",
    "n8ao": "^2.0.1",
    "postprocessing": "^6.39.5",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@capacitor/cli": "~7.6.9",
    "@types/three": "^0.186.0",
    "jpeg-js": "^0.4.4",
    "pngjs": "^7.0.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "~4.1.11"
  }
}
